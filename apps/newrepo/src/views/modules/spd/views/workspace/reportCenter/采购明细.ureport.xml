        <dataset name="采购明细" type="sql">
            <sql>
                <![CDATA[${ var sql="SELECT o.AD_Org_ID, o.OrgName, o.M_InOut_ID InOutId
                ,o.M_InOutLine_ID InOutLineId,o.documentno inoutNo,o.OrderNo, to_char(o.MovementDate,\'yyyy-MM-dd\')
                MovementDate, o.C_Order_ID,o.C_OrderLine_ID,o.MovementTypeName,o.IsSOTrx,
                o.BPartnerName ,o.C_BPartner_ID bPartnerId, o.DocStatus,o.DocStatusName,o.Description,o.M_Warehouse_ID
                warehouseId,o.WarehouseName, o.M_Product_ID productId,o.productfullname
                ProductName, o.MedicineName,o.ProductSpec,o.Manufacturer,o.ProductCode,o.BaseUOMQty,
                getconvertspec(o.M_Warehouse_ID,o.M_Product_ID ) specConvert, o.C_UOM_ID
                uomid,o.UOMName,o.Lot,to_char(o.GuaranteeDate,\'yyyy-MM-dd\') GuaranteeDate,case
                when o.MovementType=\ 'V-\' then o.MovementQty*(-1) else o.MovementQty
                end MovementQty, o.Price,o.StorageStatusName,o.LocatorName, case when o.MovementType=\
                'V-\' then o.LineAmt*(-1) else o.LineAmt end LineAmt,NVL(ra.DocumentNo,o.orderNo)
                applyNo,o.TaxInvoiceNo,o.TaxInvoiceDate,o.M_Product_ID,o.createdByName,o.orderType,
                o.orderTypeName,o.vendor_ID vendorId,o.vendorName,o.orderTypeName docTypeName
                FROM M_InOutLine_V o LEFT JOIN C_ReturnApply ra ON (ra.C_ReturnApply_ID=o.C_ReturnApply_ID)
                WHERE o.DocStatus!=\'VO\' AND o.Processed=\'Y\' AND o.MovementType in (\'V+\',\'V-\')
                "; if (param("warehouseId")!=null && param('warehouseId')!=''){ sql=s ql
                + " and o.m_warehouse_id=:warehouseId"; } if (param("bpartnerId")!=null
                && param('bpartnerId')!=''){ sql=s ql + " and o.C_BPartner_ID=:bpartnerId";
                } if (param("dateFrom")!=null && param('dateFrom')!=''){ sql=s ql + " and
                o.movementdate>:dateFrom";
                }
                if (param("dateTo")!=null && param('dateTo')!=''){
                sql = sql + " and o.movementdate<=:dateTo+1";
                }
                if (param("AD_Org_ID")!=null && param('AD_Org_ID')!=''){
                sql = sql + " and o.AD_Org_ID=:AD_Org_ID";
                }
                if (param("productType")!=null && param('productType')!=''){
                sql = sql + " and o.producttype=:productType";
                }
                if (param("AD_User_ID")!=null && param('AD_User_ID')!=''){
                sql = sql + " AND o.M_Warehouse_ID IN (SELECT wu.M_Warehouse_ID FROM M_Warehouse_User wu WHERE wu.IsActive=\'Y\' AND wu.AD_User_ID=:AD_User_ID ) ";
                }
                sql= sql+" ORDER BY  o.M_InOut_ID DESC  ";
                return sql
                }]]>
            </sql>
