# 应用标题
VITE_APP_TITLE=药品供应链精细化管理平台

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=vben-web-play

# 路由的base 地址
VITE_BASE="spd"

# 机构对应到页面的显示名称 默认是物流中心， 某些项目会用到 机构 或者 货主
VITE_INSTITUTION_APPELLATION=医院

# 是否在登录时选择机构 login 登录时强制选择机构 inner 登录后在内部强制选择机构 false 不强制选择机构
VITE_CHOOSE_INSTITUTION=false

#  是否启用仓库信息
VITE_HAS_WAREHOUSE_INFO=false

# 是否开启websocket
VITE_WEBSOCKET_ENABLE=true
